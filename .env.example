# Copy to .env and fill in. .env is gitignored — never commit a real value here.

# --- Database -----------------------------------------------------------------
# Three roles, and the separation is the security boundary. Run
# `npm run db:migrate` then `npm run db:bootstrap-roles` to create the first two
# and print their connection strings.
#
# Do NOT put the connection string Neon hands you in DATABASE_URL. That role
# owns every table and has BYPASSRLS, so no policy would apply to it and the app
# refuses to start with it. It belongs in DATABASE_URL_OWNER.

# app_user on the POOLED host: all tenant traffic, under row-level security.
# postgresql://app_user:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=

# auth_user on the POOLED host: Auth.js only. Reaches the identity tables and
# nothing else.
AUTH_DATABASE_URL=

# The table owner on the DIRECT (non-pooled) host. Migrations and seeding only —
# never give this to the running app.
DATABASE_URL_OWNER=

# --- Auth.js ------------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
# Optional: set when the deployment URL is not inferable (Auth.js trusts the host by default).
AUTH_URL=
AUTH_EMAIL_FROM="Stead <onboarding@resend.dev>"

# --- Email --------------------------------------------------------------------
# Magic-link delivery. Leave blank in local dev and the link prints to the
# server console instead of being emailed.
RESEND_API_KEY=
OPS_ALERT_EMAIL= # where cron-failure alerts go

# --- Scheduled jobs -----------------------------------------------------------
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`. openssl rand -hex 32
CRON_SECRET=

# --- Stripe (test mode) -------------------------------------------------------
STRIPE_SECRET_KEY= # sk_test_...
VITE_STRIPE_PUBLISHABLE_KEY= # pk_test_...
STRIPE_WEBHOOK_SECRET= # whsec_... from `stripe listen`
# Test Connect account id (acct_...) stamped onto the seed host. Create one in
# the Stripe Dashboard under Connect → Accounts. This is an account id, not a
# secret key — never commit sk_/rk_ values. Leave blank to seed without it;
# live Stripe bookings then fail closed instead of charging the platform.
STRIPE_TEST_CONNECT_ACCOUNT_ID=

# --- Object storage (S3-compatible; photos and claim evidence, Slice 3) -------
# Any S3 API works: AWS S3, Cloudflare R2, Backblaze B2, or MinIO locally.
# See README "Object storage" for the MinIO recipe.
S3_ENDPOINT= # http://127.0.0.1:9000 for MinIO
S3_REGION=us-east-1
S3_BUCKET=stead
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true # required by MinIO; false for AWS S3
S3_PUBLIC_URL= # public base URL photos are served from

# --- Trust Passport signing (openssl genpkey -algorithm ed25519 | base64 -w0) -
PASSPORT_SIGNING_KEY=

APP_URL=http://localhost:5173
