# Supabase (project settings → API)
# Live project (owner's choice): stead-dev, us-east-1, ref aqkjkarrhancuqxxukus
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY= # server/edge functions only — never ship to client

# Optional: Postgres URL for Vitest overlap / expire / RLS tests (CI sets this)
DATABASE_URL=

# Stripe (test mode)
STRIPE_SECRET_KEY= # sk_test_...
VITE_STRIPE_PUBLISHABLE_KEY= # pk_test_...
STRIPE_WEBHOOK_SECRET= # whsec_... from `stripe listen`

# Email
RESEND_API_KEY=
OPS_ALERT_EMAIL= # where cron-failure alerts go

# Trust Passport signing (openssl genpkey -algorithm ed25519 | base64 -w0)
PASSPORT_SIGNING_KEY=

APP_URL=http://localhost:5173
